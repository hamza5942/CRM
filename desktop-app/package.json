{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "Employee Attendance & Activity Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux tar.gz"
  },
  "build": {
    "appId": "com.codexcrm.employeetracker",
    "productName": "Employee Tracker",
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Employee Tracker"
    },
    "protocols": [
      {
        "name": "crm-tracker",
        "schemes": [
          "crm-tracker"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      ".env",
      "icon.ico",
      "icon.png",
      "package.json"
    ]
  },
  "keywords": [],
  "author": "Codex Solutions",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^25.1.8"
  }
}
