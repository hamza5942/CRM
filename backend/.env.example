PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/crm_tracker
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRES_IN=3650d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Used once by `npm run create-admin` to provision the first administrator.
ADMIN_NAME=CRM Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
